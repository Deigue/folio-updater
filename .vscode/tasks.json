{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "./build.ps1",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "coverage",
            "type": "process",
            "command": "uv",
            "args": [
                "run",
                "python",
                "-m",
                "pytest",
                "-n",
                "4",
                "--cov=.",
                "--cov-report=term-missing",
                "--log-cli-level=ERROR"
            ],
            "group": "test",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "ruff check",
            "type": "process",
            "command": "uv",
            "args": ["run", "ruff", "check"],
            "group": "test",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "ty check",
            "type": "process",
            "command": "uv",
            "args": ["run", "ty", "check"],
            "group": "test",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "lint (ruff + ty)",
            "dependsOn": ["ruff check", "ty check"],
            "dependsOrder": "sequence",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}